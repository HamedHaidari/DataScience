    def _setup_rag_pipeline(self): # Unverändert in der Logik, verwendet aber die zwei Modellvariablen
        self.status_var.set("Initialisiere RAG Pipeline...")
        self.master.update_idletasks()
        if not self.pdf_file_paths:
            messagebox.showwarning("Keine PDFs", "Bitte wählen Sie zuerst PDF-Dateien aus."); self.status_var.set("Fehler: Keine PDFs ausgewählt."); return
        all_docs = []
        for pdf_path in self.pdf_file_paths:
            try: loader = PyPDFLoader(pdf_path); documents = loader.load(); all_docs.extend(documents)
            except Exception as e: messagebox.showerror("Ladefehler", f"Fehler: {e}"); self.status_var.set(f"Fehler: {e}"); return
        if not all_docs:
            all_docs = [Document(page_content="Kein Inhalt aus PDFs geladen.")]; messagebox.showinfo("Kein Inhalt", "Kein Inhalt aus PDFs.")
        try:
            chunk_size = int(self.chunk_size_var.get()); chunk_overlap = int(self.chunk_overlap_var.get())
            k = int(self.k_var.get()); embedding_model_name = self.ollama_embedding_model_var.get()
            chat_model_name = self.ollama_chat_model_var.get(); temperature = float(self.temperature_var.get())
            num_ctx_val = int(self.num_ctx_var.get()); num_predict_val = int(self.num_predict_var.get())
            prompt_template_str = self.prompt_template_text.get("1.0", tk.END).strip()
        except ValueError as e: messagebox.showerror("Eingabefehler", f"Ungültige Zahlen: {e}"); self.status_var.set("Fehler: Ungültige Zahl."); return
        if not embedding_model_name: messagebox.showerror("Eingabefehler", "Kein Embedding-Modell."); self.status_var.set("Fehler: Embedding-Modell fehlt."); return
        if not chat_model_name: messagebox.showerror("Eingabefehler", "Kein Chat-Modell."); self.status_var.set("Fehler: Chat-Modell fehlt."); return
        text_splitter = RecursiveCharacterTextSplitter(chunk_size=chunk_size, chunk_overlap=chunk_overlap)
        self.split_docs = text_splitter.split_documents(all_docs)
        if not self.split_docs: self.split_docs = [Document(page_content="Keine Dokumente zum Splitten.")]; messagebox.showwarning("Keine Split-Dokumente", "Keine Dokumente nach Splitting.")
        try:
            self.status_var.set(f"Erstelle Embeddings mit '{embedding_model_name}'..."); self.master.update_idletasks()
            embedding_object = OllamaEmbeddings(model=embedding_model_name)
            self.status_var.set(f"Erstelle Vectorstore..."); self.master.update_idletasks()
            vectorstore = SKLearnVectorStore.from_documents(documents=self.split_docs, embedding=embedding_object)
            self.retriever = vectorstore.as_retriever(search_kwargs={"k": k})
            prompt = PromptTemplate(template=prompt_template_str, input_variables=["question", "documents"])
            llm = ChatOllama(model=chat_model_name, temperature=temperature, num_ctx=num_ctx_val, num_predict=num_predict_val)
            self.rag_chain = prompt | llm | StrOutputParser()
            self.rag_application = RAGApplication(self.retriever, self.rag_chain)
            self.status_var.set(f"RAG Pipeline: Emb '{embedding_model_name}', Chat '{chat_model_name}'.")
        except Exception as e:
            error_message = f"Fehler bei RAG-Pipeline-Setup: {e}"
            if "this model does not support embeddings" in str(e).lower(): error_message = f"Fehler: Embedding-Modell '{embedding_model_name}' unterstützt keine Embeddings.\nOriginal: {e}"
            elif "Connection refused" in str(e) or "Failed to connect" in str(e): error_message += f"\nOllama scheint nicht zu laufen."
            messagebox.showerror("Initialisierungsfehler", error_message); self.status_var.set(f"Fehler bei Pipeline-Setup."); print(error_message)

    def setup_rag_pipeline_threaded(self): # Unverändert
        self.disable_buttons(); thread = threading.Thread(target=self._setup_rag_pipeline); thread.daemon = True; thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

    def _get_answer(self): # Unverändert
        self.status_var.set("Generiere Antwort..."); self.master.update_idletasks()
        question = self.question_entry.get()
        if not question: messagebox.showwarning("Keine Frage", "Bitte Frage eingeben."); self.status_var.set("Bereit."); return
        if not self.rag_application: messagebox.showerror("Nicht initialisiert", "Pipeline nicht initialisiert."); self.status_var.set("Fehler: RAG nicht initialisiert."); return
        self.answer_text.config(state='normal'); self.answer_text.delete("1.0", tk.END)
        try: answer = self.rag_application.run(question); self.answer_text.insert(tk.INSERT, answer)
        except Exception as e: self.answer_text.insert(tk.INSERT, f"Fehler: {e}"); messagebox.showerror("Fehler bei Antwort", f"Fehler: {e}")
        finally: self.answer_text.config(state='disabled'); self.status_var.set("Antwort generiert.")

    def get_answer_threaded(self): # Unverändert
        self.disable_buttons(); thread = threading.Thread(target=self._get_answer); thread.daemon = True; thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

    def disable_buttons(self): # Erweitert um model_to_delete_combobox
        for child in self.master.winfo_children():
            if isinstance(child, tk.LabelFrame):
                for widget in child.winfo_children():
                    if isinstance(widget, (tk.Button, ttk.Button, ttk.Combobox)): widget.config(state=tk.DISABLED)
                    elif isinstance(widget, tk.Frame): # Für install_frame und delete_frame
                        for sub_widget in widget.winfo_children():
                             if isinstance(sub_widget, (tk.Button, ttk.Combobox)): sub_widget.config(state=tk.DISABLED)


    def enable_buttons(self): # Erweitert um model_to_delete_combobox
        for child in self.master.winfo_children():
             if isinstance(child, tk.LabelFrame):
                for widget in child.winfo_children():
                    if isinstance(widget, (tk.Button, ttk.Button)): widget.config(state=tk.NORMAL)
                    elif isinstance(widget, tk.Frame): # Für install_frame und delete_frame
                        for sub_widget in widget.winfo_children():
                            if isinstance(sub_widget, (tk.Button)): sub_widget.config(state=tk.NORMAL)
        # Comboboxen separat behandeln
        if self.available_ollama_models:
            self.embedding_model_combobox.config(state="readonly")
            self.chat_model_combobox.config(state="readonly")
            self.model_to_delete_combobox.config(state="readonly") # NEU
        else:
            self.embedding_model_combobox.config(state="disabled")
            self.chat_model_combobox.config(state="disabled")
            self.model_to_delete_combobox.config(state="disabled") # NEU

    def check_thread_and_enable_buttons(self, thread): # Unverändert
        if thread.is_alive(): self.master.after(100, self.check_thread_and_enable_buttons, thread)
        else: self.enable_buttons()

