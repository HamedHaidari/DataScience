    def _execute_command(self, command_list):
        try:
            process = subprocess.Popen(
                command_list,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                encoding='utf-8',
                errors='replace',
                creationflags=subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0
            )
            stdout, stderr = process.communicate()
            if process.returncode != 0:
                if ("No such file or directory" in stderr or "Der Befehl" in stderr and "nicht gefunden" in stderr) and command_list[0] == "ollama":
                    return False, f"Fehler: Der Befehl '{command_list[0]}' wurde nicht gefunden. Ist Ollama korrekt installiert und im PATH? \nFür die Installation besuchen Sie: {self.ollama_download_url}"
                return False, stderr.strip()
            return True, stdout.strip()
        except FileNotFoundError:
            return False, f"Fehler: Der Befehl '{command_list[0]}' wurde nicht gefunden. Ist Ollama korrekt installiert und im PATH? \nFür die Installation besuchen Sie: {self.ollama_download_url}"
        except Exception as e:
            return False, f"Ein unerwarteter Fehler ist aufgetreten: {e}"

    def _handle_ollama_not_found(self, error_message):
        if messagebox.askyesno("Ollama nicht gefunden",
                               f"{error_message}\n\nMöchten Sie die Ollama Download-Seite jetzt öffnen?",
                               icon='warning'):
            webbrowser.open_new_tab(self.ollama_download_url)
        self.status_var.set("Ollama nicht gefunden. Bitte installieren und erneut versuchen.")
        self.embedding_model_combobox.set(''); self.chat_model_combobox.set(''); self.model_to_delete_combobox.set('')
        self.embedding_model_combobox['values'] = []; self.chat_model_combobox['values'] = []; self.model_to_delete_combobox['values'] = []
        self.embedding_model_combobox.config(state="disabled"); self.chat_model_combobox.config(state="disabled"); self.model_to_delete_combobox.config(state="disabled")


    def _refresh_ollama_models(self):
        self.status_var.set("Aktualisiere Ollama Modellliste...")
        self.master.update_idletasks()
        success, output = self._execute_command(["ollama", "list"])
        
        if success:
            self.available_ollama_models = []
            lines = output.splitlines()
            if len(lines) > 0 and "NAME" in lines[0].upper():
                for line in lines[1:]:
                    match = re.match(r"([^\s:]+[:\w.-]*[^\s])\s+", line)
                    if match:
                        self.available_ollama_models.append(match.group(1).strip())
            
            self.embedding_model_combobox['values'] = self.available_ollama_models
            self.chat_model_combobox['values'] = self.available_ollama_models
            self.model_to_delete_combobox['values'] = self.available_ollama_models # NEU

            if self.available_ollama_models:
                # Embedding Model Auswahl
                current_emb_selection = self.ollama_embedding_model_var.get()
                if not current_emb_selection or current_emb_selection not in self.available_ollama_models:
                    default_emb_models = ["nomic-embed-text", "mxbai-embed-large", "all-minilm"]
                    chosen_default_emb = ""
                    for demb_model_base in default_emb_models:
                        for actual_model in self.available_ollama_models:
                            if demb_model_base in actual_model: chosen_default_emb = actual_model; break
                        if chosen_default_emb: break
                    if not chosen_default_emb: chosen_default_emb = self.available_ollama_models[0]
                    self.ollama_embedding_model_var.set(chosen_default_emb)
                self.embedding_model_combobox.config(state="readonly")

                # Chat Model Auswahl
                current_chat_selection = self.ollama_chat_model_var.get()
                if not current_chat_selection or current_chat_selection not in self.available_ollama_models:
                    default_chat_bases = ["llama3", "gemma2", "mistral", "qwen2", "llava"] # llava hinzugefügt
                    chosen_default_chat = ""
                    for chat_base in default_chat_bases:
                        for actual_model in self.available_ollama_models:
                            if chat_base in actual_model and "embed" not in actual_model.lower():
                                chosen_default_chat = actual_model; break
                        if chosen_default_chat: break
                    if not chosen_default_chat: chosen_default_chat = self.available_ollama_models[0]
                    self.ollama_chat_model_var.set(chosen_default_chat)
                self.chat_model_combobox.config(state="readonly")

                # Modell zum Löschen Auswahl (Standard: leer oder erstes)
                current_delete_selection = self.model_to_delete_var.get()
                if not current_delete_selection or current_delete_selection not in self.available_ollama_models:
                    self.model_to_delete_var.set(self.available_ollama_models[0]) # Oder leer lassen: self.model_to_delete_var.set("")
                self.model_to_delete_combobox.config(state="readonly")
                
                self.status_var.set(f"{len(self.available_ollama_models)} Modelle geladen. Bitte Modelle auswählen.")
            else:
                for cb in [self.embedding_model_combobox, self.chat_model_combobox, self.model_to_delete_combobox]:
                    cb.set(''); cb['values'] = []; cb.config(state="disabled")
                self.status_var.set("Keine Ollama Modelle gefunden.")
        else:
            if f"Der Befehl 'ollama' wurde nicht gefunden" in output:
                self._handle_ollama_not_found(output)
            else:
                messagebox.showerror("Fehler bei Ollama", f"Konnte 'ollama list' nicht ausführen:\n{output}")
                self.status_var.set("Fehler beim Laden der Ollama Modellliste.")
                for cb in [self.embedding_model_combobox, self.chat_model_combobox, self.model_to_delete_combobox]:
                    cb.set(''); cb['values'] = []; cb.config(state="disabled")


    def refresh_ollama_models_threaded(self):
        self.disable_buttons() # Deaktiviert auch die neuen Widgets, wenn sie korrekt behandelt werden
        thread = threading.Thread(target=self._refresh_ollama_models)
        thread.daemon = True
        thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

    def _install_ollama_model(self):
        model_name_to_install = self.model_to_install_var.get().strip()
        if not model_name_to_install:
            messagebox.showwarning("Kein Modellname", "Bitte geben Sie einen Modellnamen für die Installation ein.")
            return
        self.status_var.set(f"Installiere Modell '{model_name_to_install}'... Dies kann dauern.")
        self.master.update_idletasks()
        info_popup = tk.Toplevel(self.master); info_popup.title("Modellinstallation")
        tk.Label(info_popup, text=f"Installation von '{model_name_to_install}' läuft...\nDetails im Terminal. Fenster schließt automatisch.").pack(padx=20, pady=20)
        info_popup.transient(self.master); info_popup.grab_set()
        info_popup.geometry("+%d+%d" % (self.master.winfo_rootx()+50, self.master.winfo_rooty()+50))
        success, output = self._execute_command(["ollama", "pull", model_name_to_install])
        info_popup.destroy()
        if success:
            self.status_var.set(f"Modell '{model_name_to_install}' erfolgreich installiert/aktualisiert.")
            messagebox.showinfo("Installation Erfolgreich", f"Modell '{model_name_to_install}' wurde erfolgreich installiert oder war bereits aktuell.")
            self.model_to_install_var.set("")
            self.refresh_ollama_models_threaded()
        else:
            if f"Der Befehl 'ollama' wurde nicht gefunden" in output: self._handle_ollama_not_found(output)
            else:
                self.status_var.set(f"Fehler bei Installation von '{model_name_to_install}'.")
                messagebox.showerror("Installationsfehler", f"Fehler: {output}")

    def install_ollama_model_threaded(self):
        self.disable_buttons()
        thread = threading.Thread(target=self._install_ollama_model)
        thread.daemon = True; thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

