    def _delete_ollama_model(self):
        model_name_to_delete = self.model_to_delete_var.get()
        if not model_name_to_delete:
            messagebox.showwarning("Kein Modell ausgewählt", "Bitte wählen Sie ein Modell aus der Liste zum Löschen aus.")
            return

        if messagebox.askyesno("Löschen bestätigen", 
                               f"Sind Sie sicher, dass Sie das Modell '{model_name_to_delete}' unwiderruflich löschen möchten?",
                               icon='warning'):
            self.status_var.set(f"Lösche Modell '{model_name_to_delete}'...")
            self.master.update_idletasks()
            success, output = self._execute_command(["ollama", "rm", model_name_to_delete])

            if success:
                self.status_var.set(f"Modell '{model_name_to_delete}' erfolgreich gelöscht.")
                messagebox.showinfo("Löschen erfolgreich", f"Modell '{model_name_to_delete}' wurde gelöscht.")
                self.model_to_delete_var.set("") # Auswahl zurücksetzen
                self.refresh_ollama_models_threaded() # Liste aktualisieren
            else:
                # Prüfen, ob Ollama selbst nicht gefunden wurde
                if f"Der Befehl 'ollama' wurde nicht gefunden" in output:
                     self._handle_ollama_not_found(output)
                else:
                    self.status_var.set(f"Fehler beim Löschen von '{model_name_to_delete}'.")
                    messagebox.showerror("Löschfehler", f"Konnte Modell '{model_name_to_delete}' nicht löschen:\n{output}")
        else:
            self.status_var.set(f"Löschvorgang für '{model_name_to_delete}' abgebrochen.")

    def delete_ollama_model_threaded(self):
        self.disable_buttons()
        thread = threading.Thread(target=self._delete_ollama_model)
        thread.daemon = True
        thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)
