# --- Standard RAG Logik (unverändert) ---
class RAGApplication:
    def __init__(self, retriever, rag_chain):
        self.retriever = retriever
        self.rag_chain = rag_chain

    def run(self, question):
        if not self.retriever:
            return "Fehler: Retriever wurde nicht initialisiert. Bitte laden Sie PDFs und konfigurieren Sie die Einstellungen."
        try:
            documents = self.retriever.invoke(question)
            doc_texts = "\n".join([doc.page_content for doc in documents])
            if not doc_texts and documents:
                doc_texts = "Kein relevanter Inhalt in den abgerufenen Dokumenten gefunden."
            elif not documents:
                doc_texts = "Keine Dokumente vom Retriever zurückgegeben."
            answer = self.rag_chain.invoke({"question": question, "documents": doc_texts})
            return answer
        except Exception as e:
            return f"Fehler während der RAG-Ausführung: {e}"

