    def on_model_selected(self, event=None):
        selected_model = self.ollama_model_var.get()
        self.status_var.set(f"Modell '{selected_model}' ausgewählt.")

    def _execute_command(self, command_list):
        """Hilfsfunktion zum Ausführen von Shell-Befehlen."""
        try:
            process = subprocess.Popen(command_list, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, creationflags=subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0)
            stdout, stderr = process.communicate()
            if process.returncode != 0:
                return False, stderr.strip()
            return True, stdout.strip()
        except FileNotFoundError:
            return False, f"Fehler: Der Befehl '{command_list[0]}' wurde nicht gefunden. Ist Ollama korrekt installiert und im PATH?"
        except Exception as e:
            return False, f"Ein unerwarteter Fehler ist aufgetreten: {e}"

    def _refresh_ollama_models(self):
        self.status_var.set("Aktualisiere Ollama Modellliste...")
        self.master.update_idletasks()
        success, output = self._execute_command(["ollama", "list"])
        
        if success:
            self.available_ollama_models = []
            lines = output.splitlines()
            if len(lines) > 0 and "NAME" in lines[0]: # Header-Zeile überspringen
                for line in lines[1:]:
                    match = re.match(r"([^\s]+)\s+", line) # Erfasst den ersten Block ohne Leerzeichen (Modellname)
                    if match:
                        self.available_ollama_models.append(match.group(1))
            
            self.model_combobox['values'] = self.available_ollama_models
            if self.available_ollama_models:
                # Versuche, das aktuell ausgewählte Modell beizubehalten oder das erste auszuwählen
                current_selection = self.ollama_model_var.get()
                if current_selection not in self.available_ollama_models:
                     self.ollama_model_var.set(self.available_ollama_models[0])
                self.model_combobox.config(state="readonly")
                self.status_var.set(f"{len(self.available_ollama_models)} Modelle geladen. Modell: '{self.ollama_model_var.get()}'")
            else:
                self.model_combobox.set('')
                self.model_combobox.config(state="disabled") # Deaktivieren, wenn keine Modelle
                self.status_var.set("Keine Ollama Modelle gefunden. Bitte installieren Sie welche.")
            print(f"Verfügbare Modelle: {self.available_ollama_models}")
        else:
            messagebox.showerror("Fehler bei Ollama", f"Konnte 'ollama list' nicht ausführen:\n{output}")
            self.status_var.set("Fehler beim Laden der Ollama Modellliste.")
            self.model_combobox.set('')
            self.model_combobox['values'] = []
            self.model_combobox.config(state="disabled")

    def refresh_ollama_models_threaded(self):
        self.disable_buttons()
        thread = threading.Thread(target=self._refresh_ollama_models)
        thread.daemon = True
        thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

    def _install_ollama_model(self):
        model_name_to_install = self.model_to_install_var.get().strip()
        if not model_name_to_install:
            messagebox.showwarning("Kein Modellname", "Bitte geben Sie einen Modellnamen für die Installation ein.")
            return

        self.status_var.set(f"Installiere Modell '{model_name_to_install}'... Dies kann dauern.")
        self.master.update_idletasks()
        
        # Zeige Popup, dass die Installation läuft und man im Terminal nachschauen kann
        info_popup = tk.Toplevel(self.master)
        info_popup.title("Modellinstallation")
        tk.Label(info_popup, text=f"Installation von '{model_name_to_install}' läuft.\nDer Fortschritt ist im Terminal sichtbar, wenn Ollama dort gestartet wurde.\nDieses Fenster schließt sich bei Abschluss oder Fehler.").pack(padx=20, pady=20)
        info_popup.transient(self.master) # Popup über Hauptfenster
        info_popup.grab_set() # Modal machen
        info_popup.geometry("+%d+%d" % (self.master.winfo_rootx()+50, self.master.winfo_rooty()+50))


        success, output = self._execute_command(["ollama", "pull", model_name_to_install])
        
        info_popup.destroy() # Schließe das Popup

        if success:
            self.status_var.set(f"Modell '{model_name_to_install}' erfolgreich installiert/aktualisiert.")
            messagebox.showinfo("Installation Erfolgreich", f"Modell '{model_name_to_install}' wurde erfolgreich installiert oder war bereits aktuell.")
            self.model_to_install_var.set("") # Feld leeren
            self.refresh_ollama_models_threaded() # Liste aktualisieren
        else:
            self.status_var.set(f"Fehler bei Installation von '{model_name_to_install}'.")
            messagebox.showerror("Installationsfehler", f"Fehler bei der Installation von '{model_name_to_install}':\n{output}")

    def install_ollama_model_threaded(self):
        self.disable_buttons()
        thread = threading.Thread(target=self._install_ollama_model)
        thread.daemon = True
        thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)


    def load_pdfs(self):
        filepaths = filedialog.askopenfilenames(
            title="PDF Dateien auswählen",
            filetypes=(("PDF Dateien", "*.pdf"), ("Alle Dateien", "*.*"))
        )
        if filepaths:
            self.pdf_file_paths = list(filepaths)
            self.pdf_list_label.config(text="\n".join([os.path.basename(fp) for fp in self.pdf_file_paths]))
            self.status_var.set(f"{len(self.pdf_file_paths)} PDF(s) ausgewählt. Bitte RAG Pipeline initialisieren.")
        else:
            self.status_var.set("Keine PDFs ausgewählt.")

    def _setup_rag_pipeline(self):
        self.status_var.set("Initialisiere RAG Pipeline...")
        self.master.update_idletasks()

        if not self.pdf_file_paths:
            messagebox.showwarning("Keine PDFs", "Bitte wählen Sie zuerst PDF-Dateien aus.")
            self.status_var.set("Fehler: Keine PDFs ausgewählt.")
            return

        all_docs = []
        for pdf_path in self.pdf_file_paths:
            try:
                loader = PyPDFLoader(pdf_path)
                documents = loader.load()
                all_docs.extend(documents)
            except Exception as e:
                messagebox.showerror("Ladefehler", f"Fehler beim Laden von '{pdf_path}': {e}")
                self.status_var.set(f"Fehler beim Laden von '{pdf_path}'.")
                return
        
        if not all_docs:
            all_docs = [Document(page_content="Kein Inhalt aus PDFs geladen. Dies ist ein Platzhalter.")]
            messagebox.showinfo("Kein Inhalt", "Kein Inhalt aus den PDFs geladen oder PDFs waren leer. Ein Platzhalterdokument wird verwendet.")

        try:
            chunk_size = int(self.chunk_size_var.get())
            chunk_overlap = int(self.chunk_overlap_var.get())
            k = int(self.k_var.get())
            ollama_model = self.ollama_model_var.get() # Von Combobox
            temperature = float(self.temperature_var.get())
            prompt_template_str = self.prompt_template_text.get("1.0", tk.END).strip()
        except ValueError as e:
            messagebox.showerror("Eingabefehler", f"Ungültige Eingabe für Zahlenwerte: {e}")
            self.status_var.set("Fehler: Ungültige Eingabe.")
            return

        if not ollama_model:
            messagebox.showerror("Eingabefehler", "Kein Ollama Modell ausgewählt.")
            self.status_var.set("Fehler: Kein Ollama Modell ausgewählt.")
            return

        text_splitter = RecursiveCharacterTextSplitter(chunk_size=chunk_size, chunk_overlap=chunk_overlap)
        self.split_docs = text_splitter.split_documents(all_docs)
        if not self.split_docs:
            self.split_docs = [Document(page_content="Keine Dokumente zum Splitten vorhanden. Dies ist ein Platzhalter.")]
            messagebox.showwarning("Keine Split-Dokumente", "Keine Dokumente nach dem Splitting vorhanden. Ein Platzhalter wird verwendet.")

        try:
            embedding_object = OllamaEmbeddings(model=ollama_model)
            vectorstore = SKLearnVectorStore.from_documents(documents=self.split_docs, embedding=embedding_object)
            self.retriever = vectorstore.as_retriever(search_kwargs={"k": k})
            
            prompt = PromptTemplate(template=prompt_template_str, input_variables=["question", "documents"])
            llm = ChatOllama(model=ollama_model, temperature=temperature)
            self.rag_chain = prompt | llm | StrOutputParser()
            self.rag_application = RAGApplication(self.retriever, self.rag_chain)
            self.status_var.set(f"RAG Pipeline mit Modell '{ollama_model}' initialisiert.")
        except Exception as e:
            error_msg = f"Fehler bei RAG-Pipeline-Setup: {e}\nStellen Sie sicher, dass Ollama läuft und das Modell '{ollama_model}' verfügbar ist."
            messagebox.showerror("Initialisierungsfehler", error_msg)
            self.status_var.set(f"Fehler: {e}")
            print(error_msg)

    def setup_rag_pipeline_threaded(self):
        self.disable_buttons()
        thread = threading.Thread(target=self._setup_rag_pipeline)
        thread.daemon = True
        thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

    def _get_answer(self):
        self.status_var.set("Generiere Antwort...")
        self.master.update_idletasks()

        question = self.question_entry.get()
        if not question:
            messagebox.showwarning("Keine Frage", "Bitte geben Sie eine Frage ein.")
            self.status_var.set("Bereit. Keine Frage eingegeben.")
            return

        if not self.rag_application:
            messagebox.showerror("Nicht initialisiert", "Die RAG-Pipeline wurde noch nicht initialisiert.")
            self.status_var.set("Fehler: RAG nicht initialisiert.")
            return

        self.answer_text.config(state='normal')
        self.answer_text.delete("1.0", tk.END)
        try:
            answer = self.rag_application.run(question)
            self.answer_text.insert(tk.INSERT, answer)
        except Exception as e:
            self.answer_text.insert(tk.INSERT, f"Ein Fehler ist aufgetreten: {e}")
            messagebox.showerror("Fehler bei Antwortgenerierung", f"Fehler: {e}")
        finally:
            self.answer_text.config(state='disabled')
            self.status_var.set("Antwort generiert.")

    def get_answer_threaded(self):
        self.disable_buttons()
        thread = threading.Thread(target=self._get_answer)
        thread.daemon = True
        thread.start()
        self.master.after(100, self.check_thread_and_enable_buttons, thread)

    def disable_buttons(self):
        """Deaktiviert alle relevanten Buttons während eines Vorgangs."""
        for child in self.master.winfo_children(): # Iteriert über Haupt-Frames (config_frame, qa_frame)
            if isinstance(child, tk.LabelFrame):
                for widget in child.winfo_children():
                    if isinstance(widget, (tk.Button, ttk.Button, ttk.Combobox)):
                        widget.config(state=tk.DISABLED)
        # Spezifische Buttons, die nicht in LabelFrames sind (falls vorhanden)
        # z.B. self.mein_button.config(state=tk.DISABLED)


    def enable_buttons(self):
        """Aktiviert alle relevanten Buttons nach Abschluss eines Vorgangs."""
        for child in self.master.winfo_children():
             if isinstance(child, tk.LabelFrame):
                for widget in child.winfo_children():
                    if isinstance(widget, (tk.Button, ttk.Button)):
                        widget.config(state=tk.NORMAL)
        # Combobox speziell behandeln, da es 'readonly' sein kann
        if self.available_ollama_models:
            self.model_combobox.config(state="readonly")
        else:
            self.model_combobox.config(state="disabled")


    def check_thread_and_enable_buttons(self, thread):
        if thread.is_alive():
            self.master.after(100, self.check_thread_and_enable_buttons, thread)
        else:
            self.enable_buttons()


